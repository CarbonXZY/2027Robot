{
    "version": 4,
    "configurations": [
        {
            "name": "STM32H723",
            // 交给 CMake Tools 提供 include/define（它知道当前 preset 的真实编译参数）
            "configurationProvider": "ms-vscode.cmake-tools",
            // CMake Tools 不可用时的回落：直接读 CMake 生成的编译数据库
            "compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
            "intelliSenseMode": "windows-gcc-arm",
            "cStandard": "c11",
            "cppStandard": "c++20"
        }
    ]
}
