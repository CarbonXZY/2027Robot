<?xml version="1.0"?>
<launch>
  <arg name="robot_description" default="$(command 'cat $(find-pkg-share chassis)/urdf/chassis.urdf')"/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(var robot_description)"/>
    <param name="use_sim_time" value="false"/>
  </node>

  <node pkg="controller_manager" exec="ros2_control_node" output="screen">
    <param name="robot_description" value="$(var robot_description)"/>
    <param name="update_rate" value="1000"/>
  </node>

  <node pkg="controller_manager" exec="spawner" output="screen"
        args="mecanum_drive_controller --controller-type mecanum_drive_controller/MecanumDriveController --param-file $(find-pkg-share chassis)/config/chassis_controller.yaml"/>
</launch>
