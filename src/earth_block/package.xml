<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>earth_block</name>
  <version>0.0.0</version>
  <description>ros2_control hardware interface and controller for the earth block mechanism (1 rail motor + 2 air pumps), using shared_package's Communication_Interface for read/write.</description>
  <maintainer email="carbon@todo.todo">carbon</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>hardware_interface</depend>
  <depend>controller_interface</depend>
  <depend>pluginlib</depend>
  <depend>earth_block_msgs</depend>
  <depend>shared_package</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
