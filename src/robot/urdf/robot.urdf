<?xml version="1.0"?>
<!--
  整机 URDF：公共体 / 底盘 / 腿，按模块分区。
  两处 <ros2_control> 各自独立，各对应下位机的一帧，id 见块内 <param>。
-->
<robot name="robot">

  <!-- ========== 公共：车体 ========== -->
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <inertia ixx="0.15" ixy="0.0" ixz="0.0" iyy="0.15" iyz="0.0" izz="0.2"/>
    </inertial>
  </link>

  <!-- ========== 底盘 chassis：4 个轮子 ========== -->
  <!-- 轮半径 0.05，轮心距中心 lx=0.2、ly=0.15（lx+ly=0.35），
       需与 config/chassis_controller.yaml 的 kinematics 参数保持一致。 -->
  <link name="front_left_wheel">
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.05" length="0.02"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="front_right_wheel">
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.05" length="0.02"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="rear_left_wheel">
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.05" length="0.02"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="rear_right_wheel">
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.05" length="0.02"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- 轮子绕 Y 轴（横向）旋转 -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.2 0.15 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.2 -0.15 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.2 0.15 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.2 -0.15 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <ros2_control name="ChassisSystem" type="system">
    <hardware>
      <plugin>chassis/ChassisSystem</plugin>
      <!-- 整个底盘一帧，id 与下位机固件约定 -->
      <param name="chassis_id">1</param>
    </hardware>

    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  <!-- ========== 腿 leg：4 条腿 ========== -->
  <link name="front_left_leg"/>
  <link name="front_right_leg"/>
  <link name="rear_left_leg"/>
  <link name="rear_right_leg"/>

  <joint name="front_left_leg_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_leg"/>
    <origin xyz="0.2 0.15 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="10.0"/>
  </joint>
  <joint name="front_right_leg_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_leg"/>
    <origin xyz="0.2 -0.15 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="10.0"/>
  </joint>
  <joint name="rear_left_leg_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rear_left_leg"/>
    <origin xyz="-0.2 0.15 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="10.0"/>
  </joint>
  <joint name="rear_right_leg_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rear_right_leg"/>
    <origin xyz="-0.2 -0.15 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="10.0"/>
  </joint>

  <ros2_control name="LegSystem" type="system">
    <hardware>
      <plugin>leg/LegSystem</plugin>
      <!-- 四条腿一帧，id 与下位机固件约定 -->
      <param name="leg_id">3</param>
    </hardware>

    <joint name="front_left_leg_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_leg_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_leg_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_leg_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
